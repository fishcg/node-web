# ---------------------------------------------------------------------------
# AcGay 音频站环境变量示例
#
#   cp .env.example .env.local      # 本地开发（Next.js 自动加载 .env.local）
#   cp .env.example .env            # docker compose 会自动读取 .env
#
# .env.local / .env 都已被 git 忽略，不要提交真实密钥。
# ---------------------------------------------------------------------------

# --- MySQL 8.0（utf8mb4）---------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=acgay
DB_PASSWORD=change-me
DB_NAME=acgay

# --- 会话签名密钥 -----------------------------------------------------------
# iron-session 要求 >= 32 字符；生成方式：openssl rand -hex 32（得到 64 字符）
SESSION_SECRET=change-me-to-a-64-char-random-hex-string

# --- 站点与资源地址 ---------------------------------------------------------
# NEXT_PUBLIC_ 前缀的变量会在构建时内联进客户端产物，改完要重新构建。
# 生产必须是外部可访问的地址，否则页面里会出现 localhost 链接。
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 音频/封面所在的 OSS bucket；lib/utils.ts 的 assetUrl() 用它拼绝对地址
OSS_BASE_URL=https://acgay.oss-cn-hangzhou.aliyuncs.com

# --- 投稿上传（服务端） -----------------------------------------------------
# 只给 Node 服务端使用，不要加 NEXT_PUBLIC_ 前缀。
OSS_BUCKET=acgay
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=change-me
OSS_ACCESS_KEY_SECRET=change-me

# --- 首次创建管理员 ---------------------------------------------------------
# 本地执行 `pnpm admin:create` 时读取；生产用 kubectl exec 传环境变量，勿写进仓库。
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-to-a-strong-password

# --- 可选 -------------------------------------------------------------------
# scripts/seed.ts 在 NODE_ENV=production 时默认拒绝执行；确实需要在生产
# 演示环境灌种子数据时，显式打开（用完记得关掉）：
# ALLOW_PROD_SEED=1
#
# `next start` 的监听端口（默认 3000；容器内由 Dockerfile / k8s 设置为 3000）：
# PORT=3000
