# Keep the build context small and free of secrets.
# Anything listed here is not sent to the Docker daemon.

# --- dependencies / build output (rebuilt inside the image) ---
node_modules
.pnpm-store
.next
out
build
coverage
*.tsbuildinfo

# --- environment files: secrets must never be baked into an image ---
.env
.env.*
!.env.example

# --- version control, editors, agent config ---
.git
.gitignore
.idea
.openidea
.cursor
.claude
.vscode
*.iml
.DS_Store

# --- archived pre-Next.js application (kept in git only) ---
legacy

# --- local runtime data (seeds are read at db:seed time, never at build) ---
data
tmp

# --- deployment / CI material not needed to build the app ---
deploy
docker-compose.yml
.dockerignore
Dockerfile
Makefile

# --- documentation & test reports ---
docs
tests
README.md
AGENTS.md

# --- stray local scratch dirs ---
path
